{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p7-study.local/schemas/v1/priority-assessment.schema.json",
  "title": "PriorityAssessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "priority_assessment_id", "subject_id", "inputs", "formula_version", "score", "label"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "priority_assessment_id": {"type": "string", "pattern": "^priority:[a-z0-9._:-]+$"},
    "subject_id": {"type": "string", "minLength": 1},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exam_recurrence", "clinical_risk", "curriculum_imminence", "learner_gap", "transfer_value"],
      "properties": {
        "exam_recurrence": {"type": ["integer", "null"], "minimum": 0, "maximum": 3},
        "clinical_risk": {"type": ["integer", "null"], "minimum": 0, "maximum": 3},
        "curriculum_imminence": {"type": ["integer", "null"], "minimum": 0, "maximum": 2},
        "learner_gap": {"type": ["integer", "null"], "minimum": 0, "maximum": 2},
        "transfer_value": {"type": ["integer", "null"], "minimum": 0, "maximum": 2}
      }
    },
    "formula_version": {"const": "study-priority-v1"},
    "score": {"type": ["integer", "null"], "minimum": 0, "maximum": 28},
    "label": {"enum": ["high", "medium", "low", "unscored"]},
    "rationale": {"type": "string"}
  }
}
