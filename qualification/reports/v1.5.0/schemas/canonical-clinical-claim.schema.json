{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p7/v1.5.0/canonical-clinical-claim.schema.json",
  "title": "Canonical Clinical Claim inventory record",
  "type": "object",
  "required": ["schema_version", "record_type", "claim_id", "origin"],
  "properties": {
    "schema_version": {"const": "1.5.0-inventory.1"},
    "record_type": {"enum": ["CanonicalClinicalClaimReference", "CanonicalClinicalClaimCandidate"]},
    "claim_id": {"type": "string", "minLength": 1},
    "origin": {"enum": ["read_only_registry_reference", "candidate_from_unlinked_detector_occurrence"]},
    "clinical_validity": {"enum": ["current", "quarantined", "conflict", "pending", "unknown"]},
    "practice_current_eligibility": {"enum": ["blocked"]}
  },
  "additionalProperties": true
}
